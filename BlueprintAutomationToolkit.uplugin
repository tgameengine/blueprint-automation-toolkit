{
  "FileVersion": 3,
  "Version": 4,
  "VersionName": "1.0.3",
  "FriendlyName": "Blueprint Automation Toolkit",
  "Description": "Editor-only localhost automation bridge for AI agents to import, inspect, repair, validate, and showcase assets and control Blueprints through a typed HTTP API.",
  "Category": "Developer",
  "CreatedBy": "AkaSoft",
  "CreatedByURL": "https://github.com/tgameengine/blueprint-automation-toolkit",
  "DocsURL": "https://github.com/tgameengine/blueprint-automation-toolkit#readme",
  "MarketplaceURL": "",
  "SupportURL": "https://github.com/tgameengine/blueprint-automation-toolkit/issues",
  "CanContainContent": true,
  "IsBetaVersion": false,
  "IsExperimentalVersion": false,
  "Installed": false,
  "EnabledByDefault": false,
  "Plugins": [
    {
      "Name": "PCG",
      "Enabled": true
    },
    {
      "Name": "GeometryProcessing",
      "Enabled": true
    },
    {
      "Name": "GeometryScripting",
      "Enabled": true
    }
  ],
  "Modules": [
    {
      "Name": "BlueprintAutomationToolkit",
      "Type": "EditorNoCommandlet",
      "LoadingPhase": "Default",
      "PlatformAllowList": [
        "Win64"
      ],
      "TargetAllowList": [
        "Editor"
      ]
    }
  ]
}
